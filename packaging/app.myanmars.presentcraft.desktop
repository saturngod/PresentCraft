[Desktop Entry]
Type=Application
Name=PresentCraft
Comment=Create presentations with Markdown
Exec=PresentCraft %f
Icon=app.myanmars.presentcraft
Terminal=false
Categories=Office;Presentation;
MimeType=application/x-presentcraft;application/x-iapresenter;text/markdown;
StartupWMClass=app.myanmars.presentcraft
